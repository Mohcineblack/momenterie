# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Database (PostgreSQL/Supabase)
DATABASE_URL="your-database-connection-string"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="your-stripe-publishable-key"
STRIPE_SECRET_KEY="your-stripe-secret-key"
# For production: use the webhook secret from Stripe Dashboard
# For local dev: get this from "stripe listen --forward-to localhost:3000/api/webhooks/stripe"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# Resend (Email Service)
RESEND_API_KEY="your-resend-api-key"

# UploadThing (File Upload Service)
UPLOADTHING_TOKEN="your-uploadthing-token"
UPLOADTHING_SECRET="your-uploadthing-secret-key"

# Mapbox (Maps & Geolocation)
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"

# Cloudflare R2 (Object Storage)
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="momenterie-production"
R2_PUBLIC_BASE_URL=""

# Prodigi (Print Fulfillment)
PRODIGI_API_KEY="your-prodigi-api-key"
PRODIGI_ENV=sandbox
